# Required: OpenAI-compatible translation endpoint
BASE_URL="https://api.example.com/v1"
API_KEY="your-api-key"
MODEL="your-model-name"

# Optional: Max parallel LLM translation requests (set to 1 to fully serialize)
TRANSLATION_MAX_CONCURRENT_CALLS="3"

# Optional: Enable Modal OCR offloading
USE_MODAL="false"

# Optional (only when USE_MODAL=true): false for GPU OCR, true for CPU OCR
USE_MANGAOCR_CPU="false"

# Optional: Use the Modal detector instead of the local ONNX detector
USE_DETECTION_MODEL="false"

# Optional: Parallel page processing
LOCAL_MAX_PARALLEL_PAGES="2"
MODAL_MAX_PARALLEL_PAGES="2"

# Optional: Hugging Face token for authenticated model downloads
HF_TOKEN="hf_xxx"

# Optional but recommended for Gradio abuse protection
GRADIO_ACTION_PASSWORD="change-this-password"
